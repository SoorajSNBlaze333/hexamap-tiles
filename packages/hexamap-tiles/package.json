{
  "name": "hexamap-tiles",
  "version": "1.0.0",
  "description": "Hexagonal tile maps of the USA, India, China and Australia for React — built for analytics data.",
  "license": "MIT",
  "author": "SoorajSNBlaze333",
  "homepage": "https://github.com/SoorajSNBlaze333/hexamap-tiles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoorajSNBlaze333/hexamap-tiles.git",
    "directory": "packages/hexamap-tiles"
  },
  "bugs": {
    "url": "https://github.com/SoorajSNBlaze333/hexamap-tiles/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./3d": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "map",
    "hexagon",
    "hexbin",
    "hex-map",
    "tile-map",
    "choropleth",
    "analytics",
    "dataviz",
    "3d",
    "usa",
    "india",
    "china",
    "australia"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:geo": "node scripts/build-geo.mjs"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "framer-motion": ">=11",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": ">=0.160"
  },
  "dependencies": {
    "d3-geo": "^3.1.2"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "framer-motion": "^14.14.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tsup": "^8.5.1",
    "us-atlas": "^3.0.1",
    "vitest": "^5.1.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
